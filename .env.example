# GrantFlow app configuration. Export these in the shell, or copy the file to
# app/.env and run `node --env-file=.env dist/src/cli.js ...` (Node 22).
# Every variable is optional; without SOROBAN_RPC_URL the CLI composes
# transactions offline and prints them.

# Soroban RPC endpoint. Leave empty to stay offline.
SOROBAN_RPC_URL=
# Network passphrase (testnet default).
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Contract ids written by scripts/deploy-testnet.sh (C...). Empty = placeholder.
GRANT_ESCROW_ID=
POLICY_WALLET_ID=
# USDC Stellar Asset Contract id on the chosen network (C...).
USDC_CONTRACT_ID=

# Signing keys per role (S...). Never commit real keys.
FUNDER_SECRET=
GRANTEE_SECRET=
REVIEWER_SECRET=

# Seed data directory (default: ../data/seed relative to app/).
SEED_DIR=

# Evidence checker. With a key the LLM provider is used; without it the
# deterministic heuristic provider runs. Tests never need a key.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# Optional API base URL override (proxies). Leave empty for the default.
LLM_BASE_URL=

# Print heuristic scoring details in the evidence checklist.
GRANTFLOW_DEBUG=
